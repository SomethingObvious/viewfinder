root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,md,toml}]
indent_size = 2

# Windows PowerShell reads a script without a BOM as ANSI.
[*.{ps1,psd1}]
end_of_line = crlf
charset = utf-8-bom
